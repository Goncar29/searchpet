# SearchPet Mobile — variables de entorno

# API del backend. En local apuntá al puerto donde corre `go run ./cmd/server`.
EXPO_PUBLIC_API_URL=http://localhost:8081

# Google Sign-In — el MISMO OAuth 2.0 Web client id que el backend verifica como
# audiencia del token, y el mismo valor que usa la web en VITE_GOOGLE_CLIENT_ID.
# NO es el client id de Android: ese se registra en Google Cloud (con el SHA-1 del
# keystore) pero nunca se escribe acá.
# Público por diseño (regla #25: GIS es un cliente público, no hay secreto).
# Vacío = el botón de Google no se renderiza.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
